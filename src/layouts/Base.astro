---
import '../styles/global.css';
const { title = 'YAMINABE — Official Site', description = 'YAMINABE — Music, lyrics and information.' } = Astro.props;
const base = import.meta.env.BASE_URL;
const home = base;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="theme-color" content="#eee9d9" />
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <title>{title}</title>
</head>
<body>
  <header class="top"><div class="wrap topin"><a href={home} class="logo">YAMINABE<b>®</b></a><nav aria-label="メインナビゲーション"><a href={home}>HOME</a><a href={`${home}#music`}>MUSIC</a><a href={`${home}#lyrics`}>LYRICS</a><a href={`${home}#about`}>ABOUT</a></nav></div></header>
  <main><slot /></main>
  <footer class="footer"><div class="wrap footerin"><span>© YAMINABE</span><span>OFFICIAL WEBSITE / 2026</span></div></footer>
</body>
</html>
