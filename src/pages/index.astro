---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
const songs = (await getCollection('songs', ({data}) => data.published)).sort((a,b) => (b.data.year ?? 0) - (a.data.year ?? 0));
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const songHref = (id: string) => `${base}lyrics/${id}/`;
---
<Base>
  <section class="hero" id="home">
    <div class="wrap">
      <div class="eyebrow">INDEPENDENT MUSIC PROJECT / TOKYO</div>
      <h1>YAMI<span>NABE.</span></h1>
      <div class="herofoot"><p>SOUL / FUNK / AOR / INDIE POP<br />ORIGINAL MUSIC &amp; LYRICS</p><div class="roundel" aria-hidden="true">✳</div></div>
    </div>
  </section>
  <section class="section songs-section" id="music">
    <div class="wrap">
      <div class="sectionhead"><div><div class="eyebrow">01 / MUSIC &amp; LYRICS</div><h2>SONGS</h2></div><small>{String(songs.length).padStart(2,'0')} {songs.length === 1 ? 'SONG' : 'SONGS'}</small></div>
      <div class="songs-list">
        {songs.map((song, i) => <article class="song-row">
          <div class="song-cover" aria-hidden="true"><div class="song-record"></div></div>
          <div class="song-info">
            <div class="eyebrow">TRACK {String(i+1).padStart(2,'0')} / {song.data.year ?? 'ARCHIVE'}</div>
            <h3>{song.data.title}</h3>
            {song.data.description && <p>{song.data.description}</p>}
            <div class="song-actions">
              {song.data.audioUrl && <button class="arrowlink player-trigger" type="button" aria-expanded="false" aria-controls={`player-${i}`} data-audio-url={song.data.audioUrl}>LISTEN <span>＋</span></button>}
              <button class="arrowlink lyrics-trigger" type="button" data-lyrics-url={songHref(song.id)}>READ LYRICS <span>↗</span></button>
              <a class="song-permalink" href={songHref(song.id)} aria-label={`${song.data.title}の歌詞ページへのリンク`}>DIRECT LINK ↗</a>
            </div>
            {song.data.audioUrl && <div class="player-panel" id={`player-${i}`} hidden><div class="player-mount"></div><a class="player-external" href={song.data.audioUrl} target="_blank" rel="noopener noreferrer">OPEN IN SOUNDCLOUD ↗</a></div>}
          </div>
        </article>)}
      </div>
    </div>
  </section>
  <section class="section" id="about">
    <div class="wrap aboutgrid">
      <div><div class="eyebrow">02 / ABOUT</div><div class="sectionhead"><h2>YAMINABE.</h2></div><p>YAMINABE は、東京を拠点に活動する個人の音楽プロジェクト。<br /><br />ソウル、ファンク、AOR、インディーポップなど、さまざまな音楽から影響を受けながら、作詞・作曲・演奏・録音までを自宅で行っている。<br /><br />ジャンルにとらわれず、好きなものを好きなように混ぜ合わせる。そんな音楽の置き場所が、YAMINABE。</p></div>
      <div><div class="eyebrow" style="margin-bottom:20px">LINKS</div><div class="links"><a href="#music">SONGS / LYRICS <span>↗</span></a>{songs.find(song => song.data.audioUrl)?.data.audioUrl && <a href={songs.find(song => song.data.audioUrl)!.data.audioUrl} target="_blank" rel="noopener noreferrer">SOUNDCLOUD <span>↗</span></a>}</div></div>
    </div>
  </section>
  <dialog id="lyrics-dialog" class="lyrics-dialog" aria-label="歌詞">
    <div class="lyrics-dialog-top"><span>YAMINABE / LYRICS</span><button type="button" class="lyrics-close" aria-label="閉じる">×</button></div>
    <div class="lyrics-dialog-content" id="lyrics-dialog-content" aria-live="polite"></div>
  </dialog>
  <script>
    document.querySelectorAll<HTMLButtonElement>('.player-trigger').forEach(button => {
      button.addEventListener('click', () => {
        const id = button.getAttribute('aria-controls');
        const panel = id ? document.getElementById(id) : null;
        const mount = panel?.querySelector<HTMLElement>('.player-mount');
        const audioUrl = button.dataset.audioUrl;
        if (!panel || !mount || !audioUrl) return;
        const opening = panel.hidden;
        document.querySelectorAll<HTMLButtonElement>('.player-trigger').forEach(other => {
          other.setAttribute('aria-expanded', 'false');
          const otherPanel = document.getElementById(other.getAttribute('aria-controls') || '');
          if (otherPanel) {
            otherPanel.hidden = true;
            otherPanel.querySelector('.player-mount')?.replaceChildren();
          }
          const icon = other.querySelector('span');
          if (icon) icon.textContent = '＋';
        });
        if (!opening) return;
        const iframe = document.createElement('iframe');
        iframe.title = 'SoundCloud audio player';
        iframe.width = '100%';
        iframe.height = '166';
        iframe.allow = 'autoplay';
        iframe.loading = 'lazy';
        iframe.referrerPolicy = 'strict-origin-when-cross-origin';
        iframe.src = 'https://w.soundcloud.com/player/?url=' + encodeURIComponent(audioUrl) + '&color=%23c85a31&auto_play=false&hide_related=true&show_comments=false&show_user=true&show_reposts=false&visual=false';
        mount.replaceChildren(iframe);
        panel.hidden = false;
        button.setAttribute('aria-expanded', 'true');
        const icon = button.querySelector('span');
        if (icon) icon.textContent = '−';
      });
    });
    const dialog = document.querySelector<HTMLDialogElement>('#lyrics-dialog');
    const content = document.querySelector<HTMLElement>('#lyrics-dialog-content');
    document.querySelectorAll<HTMLButtonElement>('.lyrics-trigger').forEach(button => {
      button.addEventListener('click', async () => {
        if (!dialog || !content) return;
        const url = button.dataset.lyricsUrl;
        if (!url) return;
        content.textContent = '読み込み中…';
        dialog.showModal();
        try {
          const response = await fetch(url);
          if (!response.ok) throw new Error('Lyrics unavailable');
          const doc = new DOMParser().parseFromString(await response.text(), 'text/html');
          const title = doc.querySelector('.lyricspage h1');
          const lyrics = doc.querySelector('.lyricsbody');
          if (!title || !lyrics) throw new Error('Lyrics not found');
          content.replaceChildren(title.cloneNode(true), lyrics.cloneNode(true));
        } catch {
          content.replaceChildren(document.createTextNode('歌詞を読み込めませんでした。 '));
          const link = document.createElement('a');
          link.href = url;
          link.textContent = '歌詞ページを開く ↗';
          content.append(link);
        }
      });
    });
    document.querySelector('.lyrics-close')?.addEventListener('click', () => dialog?.close());
    dialog?.addEventListener('click', event => { if (event.target === dialog) dialog.close(); });
  </script>
</Base>
