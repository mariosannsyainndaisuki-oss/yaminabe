---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
const songs = (await getCollection('songs', ({data}) => data.published)).sort((a,b) => (b.data.year ?? 0) - (a.data.year ?? 0));
const featured = songs.find(song => song.data.featured) ?? songs[0];
const base = import.meta.env.BASE_URL;
const songHref = (id) => `${base}lyrics/${id}/`;
---
<Base>
<section class="hero" id="home"><div class="wrap"><div class="eyebrow">INDEPENDENT MUSIC PROJECT</div><h1>YAMI<span>NABE.</span></h1><div class="herofoot"><p>ORIGINAL MUSIC / LYRICS / MORE<br />OFFICIAL WEBSITE</p><div class="roundel" aria-hidden="true">✳</div></div></div></section>
<div class="ticker"><span>YAMINABE &nbsp; ✳ &nbsp; MUSIC &nbsp; ✳ &nbsp; LYRICS &nbsp; ✳ &nbsp; YAMINABE &nbsp; ✳ &nbsp; MUSIC &nbsp; ✳ &nbsp; LYRICS</span></div>
<section class="section" id="music"><div class="wrap"><div class="sectionhead"><div><div class="eyebrow">01 / MUSIC</div><h2>SELECTED TRACK</h2></div><small>ORIGINAL SONGS</small></div>{featured && <div class="featured"><div class="featureart" aria-label="レコードのグラフィック"></div><div class="featureinfo"><div><div class="eyebrow">FEATURED {featured.data.year ? `/ ${featured.data.year}` : ''}</div><h3>{featured.data.title}</h3><p>{featured.data.key && `KEY ${featured.data.key}`}{featured.data.bpm && ` / ${featured.data.bpm} BPM`}<br />{featured.data.description}</p></div><a class="arrowlink" href={songHref(featured.id)}>VIEW LYRICS <span>↗</span></a></div></div>}</div></section>
<section class="section" id="lyrics"><div class="wrap"><div class="sectionhead"><div><div class="eyebrow">02 / THE POT</div><h2>LYRICS ARCHIVE</h2></div><small>{String(songs.length).padStart(2,'0')} {songs.length === 1 ? 'SONG' : 'SONGS'}</small></div><div class="archive">{songs.map((song,i) => <a class="track" href={songHref(song.id)}><div class="cover"><span>{song.data.title}</span></div><div class="trackinfo"><small>TRACK {String(i+1).padStart(2,'0')} / {song.data.year ?? 'ARCHIVE'}</small><h3>{song.data.title}</h3></div></a>)}</div></div></section>
<section class="section" id="about"><div class="wrap aboutgrid"><div><div class="eyebrow">03 / ABOUT</div><div class="sectionhead"><h2>YAMINABE.</h2></div><p>オリジナル楽曲の制作・公開を行う音楽プロジェクト。<br />このサイトでは楽曲、歌詞、関連情報を掲載しています。</p></div><div><div class="eyebrow" style="margin-bottom:20px">LINKS</div><div class="links"><a href="#music">MUSIC <span>↗</span></a><a href="#lyrics">LYRICS / THE POT <span>↗</span></a></div></div></div></section>
</Base>
